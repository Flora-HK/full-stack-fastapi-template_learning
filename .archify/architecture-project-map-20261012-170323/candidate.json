  "cards": [
    {
      "dot": "cyan",
      "title": "前端 frontend/",
      "items": [
        "routes/ — 10 个文件路由；_layout 作登录守卫，四个公开页已登录时弹回 /",
        "components/ — Admin、Items、UserSettings 业务组件 + 24 个 shadcn/ui 原语",
        "hooks/ — useAuth（当前用户与登录态）、Toast、剪贴板、断点",
        "src/client/ — 由 openapi.json 生成的类型化 SDK（生成物，不参与 lint）",
        "tests/ — Playwright 端到端：登录、注册、管理、条目、设置、重置密码",
        "vite outDir 直指 backend/app/frontend，生产由后端同源托管"
      ]
    },
    {
      "dot": "emerald",
      "title": "后端 backend/",
      "items": [
        "app/api/routes — 登录、用户、条目、健康检查；条目按 owner_id 隔离",
        "app/api/deps — SessionDep 与 CurrentUser 依赖，OAuth2 Bearer 取 token",
        "app/core — pydantic-settings 配置、create_engine、Argon2 密码与 JWT",
        "app/models.py — User/Item 表模型 + 各层 Pydantic schema",
        "app/crud.py — 用户与条目读写、authenticate 含抗时序攻击哑哈希",
        "app/utils.py + email-templates/ — Jinja2 邮件渲染投递、重置密码 token",
        "app/alembic — 建表 → 加长度约束 → 主键改 UUID → 级联删除 → 时间戳",
        "tests/ — pytest 覆盖 API 与 CRUD，CI 覆盖率门槛 90%"
      ]
    },
    {
      "dot": "amber",
      "title": "工程化与交付",
      "items": [
        ".github/workflows — 15 条流水线：测试、部署、发布、安全、依赖、项目管理",
        "backend/Dockerfile — 两阶段：Bun 构建前端 → Python 3.14 + uv 运行 4 worker",
        "compose.yml + override + deploy — Traefik、PostgreSQL、Adminer；dev 另加 Mailpit 与 Playwright",
        "两条部署路径 — FastAPI Cloud（主）与自托管 Compose + Let's Encrypt（次）",
        "prek 预提交 — biome、ruff、mypy、ty、zizmor、前端 SDK 再生成",
        "backend/scripts/prestart.sh — 先 alembic upgrade head，再建首个超级用户"
      ]
    }
  ]
